{
  "name": "fantafort",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "repository": "https://github.com/PrimeBuild-pc/FantaFort",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:api": "node --experimental-strip-types scripts/check-fortnite.mjs",
    "check:api-bounds": "node --experimental-strip-types scripts/check-api-bounds.mjs",
    "check:db": "node --env-file-if-exists=.env.local scripts/check-social.mjs",
    "check:community": "node --env-file-if-exists=.env.local scripts/check-community.mjs",
    "check:auth": "node --experimental-strip-types scripts/check-auth-redirect.mjs",
    "check:admin": "node scripts/check-admin-security.mjs && node --experimental-strip-types scripts/check-admin-config.mjs && node --experimental-strip-types scripts/check-admin-jwt.mjs",
    "check:client-secrets": "node scripts/check-client-secrets.mjs",
    "check:headers": "node --experimental-strip-types scripts/check-security-headers.mjs",
    "check:staging-security": "node --env-file=.env.staging.local scripts/check-staging-security.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:pool": "node --experimental-strip-types scripts/check-player-pool.mjs",
    "sync:players": "node --experimental-strip-types --env-file-if-exists=.env.local scripts/sync-player-pool.mjs --full",
    "import:results": "node --env-file-if-exists=.env.local scripts/import-results.mjs",
    "sync:results": "node --experimental-strip-types --env-file-if-exists=.env.local scripts/sync-fortnite.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "next": "^16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "typescript": "^6.0.3"
  }
}

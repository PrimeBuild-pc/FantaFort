# Browser-visible Supabase configuration. Publishable/anon keys are public by design.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy client-key fallback; leave unset when a publishable key is configured.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Cloudflare Turnstile site key; public by design. Keep unset until hosted CAPTCHA is ready.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only admin controls. Values are case-sensitive.
# Production enforces MFA even if this value is absent, false or malformed.
ADMIN_MFA_ENFORCEMENT_ENABLED=true
# Keep both mutation flags false until a separately approved activation.
ADMIN_MUTATIONS_ENABLED=false
ADMIN_ANONYMIZATION_ENABLED=false

# Local tooling and GitHub Actions only while admin mutations are disabled.
# Never add these to Vercel or give them a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
